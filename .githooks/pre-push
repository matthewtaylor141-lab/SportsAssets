#!/bin/sh
# PRE-PUSH DEPLOY GUARD -- added 2026-09-12 after an accidental production deploy.
#
# WHAT HAPPENED. Commit 14172bc (all of run 83.2) was pushed with no
# [skip render] tag while the owner's instruction was "do NOT deploy". Render
# auto-deploys any commit reaching the service's branch, so the push itself was
# the deploy: sportsassets-api went live on it at 17:23:55Z and migration 063
# applied at boot. Nothing was dispatched; the omission of a tag was the action.
#
# WHY THIS IS A PRE-PUSH HOOK AND NOT ONLY CI. Render deploys ON PUSH. A CI job
# runs AFTER the push, so it can only report a deploy that has already started.
# Only a pre-push hook can actually prevent one. CI is the backstop and the
# audit trail; this file is the prevention.
#
# THE RULE. Every commit being pushed must carry either:
#     [skip render]        -- this commit must not deploy
#     [deploy-approved]    -- the owner approved deploying this commit
# A commit with neither is refused. There is no third state: "I did not think
# about whether this deploys" is exactly the state that caused the incident.
#
# Bypass is possible with `git push --no-verify`, deliberately. A guard that
# cannot be bypassed becomes a reason to disable the hook wholesale, and the
# flag leaves a visible choice in the shell history rather than a silent one.

ZERO='0000000000000000000000000000000000000000'
fail=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion: nothing to check

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch: check every commit not already reachable from any other ref,
        # so a first push does not have to re-justify the whole history.
        range=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
    else
        range=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
    fi

    for sha in $range; do
        msg=$(git log -1 --format=%B "$sha")
        case "$msg" in
            *'[skip render]'*|*'[deploy-approved]'*) : ;;
            *)
                if [ "$fail" -eq 0 ]; then
                    echo ""
                    echo "PUSH REFUSED -- deploy guard (.githooks/pre-push)"
                    echo ""
                    echo "Render auto-deploys every commit that reaches the service branch,"
                    echo "so pushing an untagged commit IS a deploy. Commit 14172bc went live"
                    echo "on 2026-09-12 exactly this way, against an explicit instruction."
                    echo ""
                    echo "These commits carry neither [skip render] nor [deploy-approved]:"
                    echo ""
                fi
                fail=1
                printf '  %s  %s\n' "$(echo "$sha" | cut -c1-9)" "$(git log -1 --format=%s "$sha")"
                ;;
        esac
    done
done

if [ "$fail" -ne 0 ]; then
    cat <<'MSG'

Fix with ONE of:

  git commit --amend            # add [skip render] to the message
  git rebase -i <base>          # amend several messages
  git push --no-verify          # deliberate override, visible in shell history

[skip render]      this commit must not deploy (the default for research and
                   for code awaiting review)
[deploy-approved]  the owner approved deploying THIS commit

MSG
    exit 1
fi
exit 0
