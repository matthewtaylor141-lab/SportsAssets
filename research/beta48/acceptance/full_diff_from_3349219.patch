                 take-band) SQL="WITH e AS (SELECT o.id, CASE WHEN o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') THEN 'rest_replaced' ELSE COALESCE(o.decision, 'unrecorded') END AS decision, o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') AS replaced, o.filled, o.wire, o.qty, o.tif, o.ask_at_send, CASE WHEN o.his_level IS NULL OR o.ask_at_place IS NULL THEN NULL ELSE round(((o.ask_at_place::numeric - floor(round((o.his_level * 100)::numeric, 6)) / 100) * 100)::numeric, 0) END AS band_c, CASE WHEN o.his_level IS NULL THEN NULL ELSE round(((o.wire::numeric - floor(round((o.his_level * 100)::numeric, 6)) / 100) * 100)::numeric, 1) END AS paid_c, CASE WHEN m.resolved_prices IS NULL OR mt.outcome_index IS NULL THEN NULL ELSE (m.resolved_prices->>mt.outcome_index)::numeric END AS payoff FROM mirror_orders o JOIN mirror_books b ON b.id = o.book_id LEFT JOIN market_tokens mt ON mt.token_id = b.long_asset LEFT JOIN markets m ON m.condition_id = b.condition_id WHERE b.whale = 'rn1' AND b.intent = 'ORDER_INTENT_BUY_LONG' AND o.side = 'BUY_LONG' AND o.kind IN ('increase', 'take') AND o.placed_at >= now() - interval '24 hours'), x AS (SELECT e.*, CASE WHEN band_c IS NULL THEN 'unread' WHEN band_c <= 0 THEN '<=0' WHEN band_c = 1 THEN '1' WHEN band_c = 2 THEN '2' ELSE '3+' END AS bucket FROM e) SELECT COALESCE(decision, 'ALL') AS decision, COALESCE(bucket, 'ALL') AS bucket, count(*) AS n, count(*) FILTER (WHERE filled > 0) AS filled_n, sum(count(*) FILTER (WHERE replaced)) OVER (PARTITION BY regexp_replace(decision, '_replaced$', ''), bucket) AS replaced_n, round(100.0 * count(*) FILTER (WHERE filled > 0) / count(*), 1) AS fill_pct, round(sum(filled * wire)::numeric, 2) AS our_usd, count(*) FILTER (WHERE filled > 0 AND payoff IS NOT NULL) AS n_resolved, round((sum(filled * (payoff - wire)) FILTER (WHERE filled > 0 AND payoff IS NOT NULL) / NULLIF(sum(filled * wire) FILTER (WHERE filled > 0 AND payoff IS NOT NULL), 0))::numeric, 4) AS roi, round((1.96 * stddev_samp((payoff - wire) / NULLIF(wire, 0)) FILTER (WHERE filled > 0 AND payoff IS NOT NULL) / sqrt(NULLIF(count(*) FILTER (WHERE filled > 0 AND payoff IS NOT NULL), 0)))::numeric, 4) AS ci95, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY paid_c) FILTER (WHERE filled > 0)::numeric, 1) AS paid_med_c, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY (ask_at_send - wire) * 100) FILTER (WHERE tif = 'IOC' AND ask_at_send IS NOT NULL)::numeric, 1) AS send_ask_over_wire_med_c FROM x GROUP BY ROLLUP (decision, bucket) ORDER BY 1, 2; WITH e AS (SELECT o.id, o.book_id, CASE WHEN b.intent = 'ORDER_INTENT_BUY_SHORT' THEN 'short' ELSE 'long' END AS side, o.decision, o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') AS replaced, o.qty, o.filled, o.placed_at, o.done_at, CASE WHEN o.his_level IS NULL THEN NULL ELSE floor(round((o.his_level * 100)::numeric, 6)) END AS his_cent, round(o.wire::numeric, 4) AS wire_c FROM mirror_orders o JOIN mirror_books b ON b.id = o.book_id WHERE b.whale = 'rn1' AND o.kind IN ('increase', 'take') AND (CASE WHEN b.intent = 'ORDER_INTENT_BUY_SHORT' THEN o.side = 'SELL_LONG' ELSE o.side = 'BUY_LONG' END) AND o.placed_at >= now() - interval '24 hours'), n AS (SELECT e.*, LEAD(his_cent) OVER w AS nx_cent, LEAD(wire_c) OVER w AS nx_wire, LEAD(qty) OVER w AS nx_qty, LEAD(placed_at) OVER w AS nx_placed FROM e WINDOW w AS (PARTITION BY book_id ORDER BY placed_at, id)), z AS (SELECT side, date_trunc('hour', placed_at)::time(0) AS hour, CASE WHEN nx_placed IS NULL OR his_cent IS NULL OR nx_cent IS NULL OR wire_c IS NULL OR nx_wire IS NULL THEN 'unread' WHEN his_cent = nx_cent AND wire_c <> nx_wire THEN 'touch_moved' WHEN his_cent = nx_cent AND wire_c = nx_wire AND nx_qty = qty THEN 'same_quote' WHEN his_cent = nx_cent AND wire_c = nx_wire AND nx_qty > qty AND (nx_qty - qty) < 0.10 * greatest(qty - filled, 0) THEN 'qty_regrow' ELSE 'other' END AS pair, (decision = 'replace_unread' AND done_at - placed_at < interval '45 seconds' AND filled = 0) AS future_clock, extract(epoch FROM (done_at - placed_at)) AS done_s FROM n WHERE replaced) SELECT COALESCE(side, 'ALL') AS side, COALESCE(hour::text, 'ALL') AS hour, count(*) AS replaced, count(*) FILTER (WHERE pair = 'touch_moved') AS touch_moved, count(*) FILTER (WHERE pair = 'same_quote') AS same_quote, count(*) FILTER (WHERE future_clock) AS future_clock, count(*) FILTER (WHERE pair = 'qty_regrow') AS qty_regrow, count(*) FILTER (WHERE pair = 'other') AS other, count(*) FILTER (WHERE pair = 'unread') AS unread, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY done_s)::numeric, 0) AS done_med_s FROM z GROUP BY ROLLUP (side, hour) ORDER BY 1, 2 DESC; WITH s AS (SELECT o.id, CASE WHEN o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') THEN 'rest_replaced' ELSE COALESCE(o.decision, 'unrecorded') END AS decision, o.filled, o.wire, o.tif, CASE WHEN o.his_level IS NULL OR o.bid_at_place IS NULL THEN NULL ELSE round(((ceil(round((o.his_level * 100)::numeric, 6)) / 100 - o.bid_at_place::numeric) * 100)::numeric, 0) END AS band_c, CASE WHEN o.his_level IS NULL THEN NULL ELSE round(((ceil(round((o.his_level * 100)::numeric, 6)) / 100 - o.wire::numeric) * 100)::numeric, 1) END AS given_c, CASE WHEN m.resolved_prices IS NULL OR mt.outcome_index IS NULL THEN NULL ELSE (m.resolved_prices->>mt.outcome_index)::numeric END AS payoff FROM mirror_orders o JOIN mirror_books b ON b.id = o.book_id LEFT JOIN market_tokens mt ON mt.token_id = b.long_asset LEFT JOIN markets m ON m.condition_id = b.condition_id WHERE b.whale = 'rn1' AND b.intent = 'ORDER_INTENT_BUY_SHORT' AND o.side = 'SELL_LONG' AND o.kind IN ('increase', 'take') AND o.placed_at >= now() - interval '24 hours'), y AS (SELECT s.*, CASE WHEN band_c IS NULL THEN 'unread' WHEN band_c <= 0 THEN '<=0' WHEN band_c = 1 THEN '1' WHEN band_c = 2 THEN '2' ELSE '3+' END AS bucket FROM s) SELECT 'short' AS side, COALESC