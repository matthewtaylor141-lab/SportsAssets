                 outcome-census) SQL="WITH his AS (SELECT t.condition_id, COALESCE(NULLIF(m.sport, 'unclassified'), NULLIF(t.sport, 'unclassified'), 'unclassified') AS sport, max(t.outcome_index) AS max_oi, count(DISTINCT t.outcome_index) AS n_idx, count(DISTINCT t.asset) AS n_assets, sum(t.size * t.price) AS usd, count(*) AS fills, max(t.market_slug) AS slug FROM trades t JOIN whales w ON w.id = t.whale_id LEFT JOIN markets m ON m.condition_id = t.condition_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '7 days' AND t.condition_id IS NOT NULL GROUP BY 1, 2) SELECT COALESCE(sport, 'ALL') AS sport, count(*) AS markets, count(*) FILTER (WHERE max_oi >= 2) AS oi_ge_2, round(COALESCE(sum(usd) FILTER (WHERE max_oi >= 2), 0)::numeric, 0) AS usd_oi_ge_2, count(*) FILTER (WHERE n_assets > 2) AS over_2_tokens, round(COALESCE(sum(usd) FILTER (WHERE n_assets > 2), 0)::numeric, 0) AS usd_over_2_tokens, count(*) FILTER (WHERE n_idx = 1) AS one_side, count(*) FILTER (WHERE n_idx = 2) AS two_sides, round(sum(usd)::numeric, 0) AS usd, sum(fills) AS fills FROM his GROUP BY ROLLUP (sport) ORDER BY sum(usd) DESC LIMIT 30; WITH his AS (SELECT DISTINCT t.condition_id FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '7 days' AND t.condition_id IS NOT NULL), mt AS (SELECT k.condition_id, count(*) AS tokens, max(k.outcome_index) AS max_oi, string_agg(DISTINCT COALESCE(k.outcome, '(null)'), '/' ORDER BY COALESCE(k.outcome, '(null)')) AS outcomes FROM market_tokens k JOIN his ON his.condition_id = k.condition_id GROUP BY 1) SELECT tokens, max_oi, count(*) AS conditions, left(string_agg(DISTINCT outcomes, ' | '), 90) AS sample_outcomes FROM mt GROUP BY 1, 2 ORDER BY 1, 2 LIMIT 20; WITH his AS (SELECT t.condition_id, COALESCE(NULLIF(m.sport, 'unclassified'), NULLIF(t.sport, 'unclassified'), 'unclassified') AS sport, max(t.outcome_index) AS max_oi, count(DISTINCT t.asset) AS n_assets, sum(t.size * t.price) AS usd, max(t.market_slug) AS slug, max(left(t.market_title, 40)) AS title FROM trades t JOIN whales w ON w.id = t.whale_id LEFT JOIN markets m ON m.condition_id = t.condition_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '7 days' AND t.condition_id IS NOT NULL GROUP BY 1, 2) SELECT left(slug, 40) AS slug, sport, max_oi, n_assets, round(usd::numeric, 0) AS usd, title FROM his WHERE max_oi >= 2 OR n_assets > 2 ORDER BY usd DESC LIMIT 30;"; TO=60000 ;;
