                 sleeve-vs-him-48h) SQL="WITH bk AS (SELECT b.condition_id, sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) AS staked, sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) AS settled, count(*) AS episodes FROM mirror_books b WHERE b.whale = 'rn1' AND (b.opened_at >= now() - interval '48 hours' OR b.closed_at >= now() - interval '48 hours') AND lower(COALESCE(b.us_market_slug, '')) NOT LIKE 'aec-nfl-ne-sea-2026-09-09%' AND NOT (COALESCE(b.ledger_net, 0) = 0 AND b.settled_pnl IS NOT NULL) GROUP BY 1 HAVING sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) > 0), hf AS (SELECT d.*, sum((CASE WHEN upper(d.side) = 'BUY' THEN 1 ELSE -1 END) * d.size) OVER (PARTITION BY d.condition_id ORDER BY d.ts, d.id) AS net_after FROM (SELECT t.*, bool_or(t.source IN ('chain', 's1')) OVER (PARTITION BY t.whale_id, COALESCE(lower(NULLIF(t.tx_hash, '')), 'row:' || t.id::text), t.asset, upper(t.side)) AS has_net FROM trades t WHERE t.whale_id IN (SELECT id FROM whales WHERE lower(username) = 'rn1') AND t.ts >= now() - interval '96 hours' AND t.condition_id IN (SELECT condition_id FROM bk)) d WHERE (d.source IN ('chain', 's1') OR NOT d.has_net)), his AS (SELECT t.condition_id, sum(CASE WHEN upper(t.side) = 'BUY' THEN t.size * t.price WHEN t.net_after < 0 THEN LEAST(t.size, -t.net_after) * (1 - t.price) ELSE 0 END) AS cost, sum((CASE WHEN upper(t.side) = 'BUY' THEN 1 ELSE -1 END) * t.size * ((m.resolved_prices->>mt.outcome_index)::numeric - t.price)) AS pnl FROM hf t JOIN market_tokens mt ON mt.token_id = t.asset JOIN markets m ON m.condition_id = t.condition_id WHERE m.resolved_prices IS NOT NULL GROUP BY 1), j AS (SELECT COALESCE(NULLIF(m.sport, 'unclassified'), '(unmapped)') AS sport, bk.condition_id, bk.staked AS our_staked, bk.settled AS our_pnl, his.cost AS his_cost, his.pnl AS his_pnl FROM bk JOIN his ON his.condition_id = bk.condition_id LEFT JOIN markets m O