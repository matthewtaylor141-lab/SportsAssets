                 mirror-by-league) SQL="SELECT split_part(b.us_market_slug, '-', 2) AS lg, count(*) AS books, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) AS settled_books, round(sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL)::numeric, 2) AS staked, round(sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL)::numeric, 2) AS settled, round((100 * sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) / NULLIF(sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL), 0))::numeric, 2) AS roi_pct, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl > 0) AS won, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl < 0) AS lost, count(*) FILTER (WHERE b.intent = 'ORDER_INTENT_BUY_SHORT') AS shorts, round(sum(b.realized_pnl)::numeric, 2) AS realized_all FROM mirror_books b WHERE b.opened_at >= now() - interval '7 days' GROUP BY 1 ORDER BY staked DESC NULLS LAST LIMIT 40; SELECT split_part(b.us_market_slug, '-', 1) AS prefix, count(*) AS books, round(sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL)::numeric, 2) AS staked, round(sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL)::numeric, 2) AS settled, round((100 * sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) / NULLIF(sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL), 0))::numeric, 2) AS roi_pct, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl > 0) AS won, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl < 0) AS lost FROM mirror_books b WHERE b.opened_at >= now() - interval '7 days' GROUP BY 1 ORDER BY staked DESC NULLS LAST LIMIT 20; SELECT w.what, count(*) AS books, round(sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL)::numeric, 2) AS staked, round(sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL)::numeric, 2) AS settled, round((100 * sum(b.settled_pnl) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL) / NULLIF(sum(b.peak_exposure_usd) FILTER (WHERE b.state = 'closed' AND b.settled_pnl IS NOT NULL), 0))::numeric, 2) AS roi_pct, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl > 0) AS won, count(*) FILTER (WHERE b.state = 'closed' AND b.settled_pnl < 0) AS lost, round(sum(b.realized_pnl)::numeric, 2) AS realized_all FROM (VALUES ('24h', now() - interval '24 hours'), ('7d', now() - interval '7 days'), ('life', '2000-01-01'::timestamptz)) AS w(what, since) JOIN mirror_books b ON b.opened_at >= w.since GROUP BY 1 ORDER BY 1;"; TO=60000 ;;
                 his-matched) SQL="WITH f AS (SELECT t.condition_id, max(t.market_slug) AS market_slug, split_part(max(t.market_slug), '-', 1) AS lg, max(t.sport) AS sport, t.outcome_index AS oi, sum(CASE WHEN t.side = 'BUY' THEN t.size ELSE 0 END) AS bought, sum(CASE WHEN t.side = 'BUY' THEN t.notional ELSE 0 END) AS cost, count(*) FILTER (WHERE t.side = 'SELL') AS sells FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '7 days' AND t.outcome_index IN (0, 1) GROUP BY t.condition_id, t.outcome_index), m AS (SELECT condition_id, max(market_slug) AS market_slug, max(lg) AS lg, max(sport) AS sport, sum(cost) AS cost, sum(sells) AS sells, COALESCE(max(CASE WHEN oi = 0 THEN bought END), 0) AS b0, COALESCE(max(CASE WHEN oi = 1 THEN bought END), 0) AS b1, max(CASE WHEN oi = 0 THEN cost / NULLIF(bought, 0) END) AS p0, max(CASE WHEN oi = 1 THEN cost / NULLIF(bought, 0) END) AS p1 FROM f GROUP BY condition_id), x AS (SELECT *, LEAST(b0, b1) AS pairs, LEAST(b0, b1) * (COALESCE(p0, 0) + COALESCE(p1, 0)) AS matched_cost FROM m) SELECT lg, count(*) AS markets, count(*) FILTER (WHERE pairs > 0) AS both_sides, round(sum(cost)::numeric, 0) AS cost, round(sum(matched_cost)::numeric, 0) AS matched_cost, round((100 * sum(matched_cost) / NULLIF(sum(cost), 0))::numeric, 1) AS matched_pct, round((sum(pairs * (p0 + p1)) / NULLIF(sum(pairs), 0))::numeric, 4) AS pair_cost, round((sum(cost) - sum(matched_cost))::numeric, 0) AS residual_cost, sum(sells) AS sells FROM x GROUP BY 1 ORDER BY cost DESC LIMIT 40; WITH f AS (SELECT t.condition_id, t.outcome_index AS oi, max(t.sport) AS sport, sum(CASE WHEN t.side = 'BUY' THEN t.size ELSE 0 END) AS bought, sum(CASE WHEN t.side = 'BUY' THEN t.notional ELSE 0 END) AS cost, count(*) FILTER (WHERE t.side = 'SELL') AS sells FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '7 days' AND t.outcome_index IN (0, 1) GROUP BY 1, 2), m AS (SELECT condition_id, max(sport) AS sport, sum(cost) AS cost, sum(sells) AS sells, COALESCE(max(CASE WHEN oi = 0 THEN bought END), 0) AS b0, COALESCE(max(CASE WHEN oi = 1 THEN bought END), 0) AS b1, max(CASE WHEN oi = 0 THEN cost / NULLIF(bought, 0) END) AS p0, max(CASE WHEN oi = 1 THEN cost / NULLIF(bought, 0) END) AS p1 FROM f GROUP BY condition_id), x AS (SELECT *, LEAST(b0, b1) AS pairs, LEAST(b0, b1) * (COALESCE(p0, 0) + COALESCE(p1, 0)) AS matched_cost FROM m) SELECT COALESCE(sport, 'all') AS sport, count(*) AS markets, count(*) FILTER (WHERE pairs > 0) AS both_sides, round(sum(cost)::numeric, 0) AS cost, round(sum(matched_cost)::numeric, 0) AS matched_cost, round((100 * sum(matched_cost) / NULLIF(sum(cost), 0))::numeric, 1) AS matched_pct, round((sum(pairs * (p0 + p1)) / NULLIF(sum(pairs), 0))::numeric, 4) AS pair_cost, sum(sells) AS sells FROM x GROUP BY ROLLUP (sport) ORDER BY cost DESC LIMIT 30; SELECT 'sells 7d' AS what, count(*) FILTER (WHERE t.side = 'SELL') AS sells, count(*) AS fills, round(sum(t.notional) FILTER (WHERE t.side = 'SELL')::numeric, 0) AS sold_usd, round(sum(t.notional)::numeric, 0) AS usd FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '7 days';"; TO=90000 ;;
