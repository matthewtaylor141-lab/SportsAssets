(decision, bucket) ORDER BY 1, 2; WITH x AS (SELECT o.id, o.book_id, CASE WHEN o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') THEN CASE WHEN b.intent = 'ORDER_INTENT_BUY_SHORT' THEN 'cover_replaced' ELSE 'exit_rest_replaced' END ELSE o.decision END AS decision, o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') AS replaced, o.side, o.qty, o.filled, o.his_level, o.placed_at, o.done_at, b.settled_pnl, CASE WHEN o.his_level IS NULL THEN NULL WHEN o.side = 'SELL_LONG' AND o.bid_at_place IS NOT NULL THEN round(((o.his_level - o.bid_at_place) * 100)::numeric, 0) WHEN o.side = 'BUY_LONG' AND o.ask_at_place IS NOT NULL THEN round(((o.ask_at_place - o.his_level) * 100)::numeric, 0) END AS band_c FROM mirror_orders o JOIN mirror_books b ON b.id = o.book_id WHERE b.whale = 'rn1' AND o.placed_at >= now() - interval '24 hours' AND (CASE WHEN b.intent = 'ORDER_INTENT_BUY_SHORT' THEN o.side = 'BUY_LONG' ELSE o.side = 'SELL_LONG' END) AND o.decision IN ('exit_rest', 'take', 'cover', 'exit_take_in_band', 'cover_in_band', 'replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread')), y AS (SELECT x.*, CASE WHEN band_c IS NULL THEN 'unread' WHEN band_c <= 0 THEN '<=0' WHEN band_c = 1 THEN '1' WHEN band_c = 2 THEN '2' WHEN band_c <= 5 THEN '3-5' ELSE '>5' END AS bucket, extract(epoch FROM (done_at - placed_at)) AS done_s FROM x), bb AS (SELECT book_id, decision, bucket, bool_or(filled > 0) AS any_filled, max(settled_pnl) AS settled FROM y GROUP BY 1, 2, 3) SELECT COALESCE(decision, 'ALL') AS decision, COALESCE(bucket, 'ALL') AS bucket, count(*) AS books, count(*) FILTER (WHERE any_filled) AS books_filled, round(sum(settled) FILTER (WHERE any_filled)::numeric, 2) AS settled_when_filled, count(*) FILTER (WHERE NOT any_filled) AS books_unfilled, round(sum(settled) FILTER (WHERE NOT any_filled)::numeric, 2) AS settled_when_unfilled FROM bb GROUP BY ROLLUP (decision, bucket) ORDER BY 1, 2; WITH i AS (SELE