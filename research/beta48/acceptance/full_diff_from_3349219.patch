s_live AS live, r.cand_reads AS reads, round(r.tick_s::numeric, 1) AS tick_s FROM mirror_candidate_refusals r JOIN mirror_books b ON b.condition_id = r.condition_id AND lower(r.whale) = lower(b.whale) WHERE b.id = $BK ORDER BY r.at DESC LIMIT 40; SELECT s.at::timestamp(0) AS judged, left(s.reason, 44) AS reason, round(s.his_net::numeric, 1) AS his_net, s.target, s.ledger_net AS ledger, s.venue_net AS venue, s.bid, s.ask, left(s.detail::text, 300) AS detail FROM mirror_shadow s JOIN mirror_books b ON b.condition_id = s.condition_id AND lower(s.whale) = lower(b.whale) WHERE b.id = $BK ORDER BY s.at DESC LIMIT 30; SELECT b2.id, b2.intent, b2.state, b2.frozen_reason, b2.last_reason, b2.opened_at::timestamp(0) AS opened, b2.closed_at::timestamp(0) AS closed, b2.ledger_net AS ledger, b2.venue_net AS venue, b2.target, round(b2.his_net::numeric, 1) AS his_net, round(b2.realized_pnl::numeric, 2) AS realized, round(b2.settled_pnl::numeric, 2) AS settled FROM mirror_books b2 JOIN mirror_books b ON b.condition_id = b2.condition_id AND lower(b2.whale) = lower(b.whale) WHERE b.id = $BK ORDER BY b2.id;"; TO=30000 ;;
                 his-day) SQL="WITH his AS (SELECT t.condition_id, t.side, t.size, t.price, t.ts, COALESCE((m.resolved_prices->>mt.outcome_index)::numeric, NULL) AS rp, (m.resolved_prices IS NOT NULL) AS settled, EXISTS (SELECT 1 FROM mirror_books b WHERE b.condition_id = t.condition_id AND b.whale = 'rn1') AS ours FROM (SELECT t.*, bool_or(t.source IN ('chain', 's1')) OVER (PARTITION BY t.whale_id, COALESCE(lower(NULLIF(t.tx_hash, '')), 'row:' || t.id::text), t.asset, upper(t.side)) AS has_net FROM trades t WHERE t.whale_id IN (SELECT id FROM whales WHERE lower(username) = 'rn1') AND t.ts >= now() - interval '48 hours') t JOIN whales w ON w.id = t.whale_id JOIN market_tokens mt ON mt.token_id = t.asset LEFT JOIN markets m ON m.condition_id = t.condition_id WHERE lower(w.username) = 'rn1' AND (t.source IN ('chain', 's1') OR NOT t.has_net) AND t.ts >= now() - interval '24 hours') SELECT CASE WHEN ours THEN 'markets we mirror' ELSE 'markets we do not mirror' END AS bucket, settled, count(DISTINCT condition_id) AS markets, count(*) AS fills, round(sum(size * price)::numeric, 0) AS usd_traded, round(sum(CASE WHEN settled THEN (CASE WHEN upper(side) = 'BUY' THEN 1 ELSE -1 END) * size * (rp - price) ELSE 0 END)::numeric, 0) AS his_settled_pnl FROM his GROUP BY 1, 2 ORDER BY 1, 2; SELECT left(COALESCE(max(t.market_slug), ''), 44) AS his_slug, count(*) AS fills, round(sum(t.size * t.price)::numeric, 0) AS usd, round(sum((CASE WHEN upper(t.side) = 'BUY' THEN 1 ELSE -1 END) * t.size * ((m.resolved_prices->>mt.outcome_index)::numeric - t.price))::numeric, 0) AS his_pnl, EXISTS (SELECT 1 FROM mirror_books b WHERE b.condition_id = t.condition_id AND b.whale = 'rn1') AS ours FROM (SELECT t.*, bool_or(t.source IN ('chain', 's1')) OVER (PARTITION BY t.whale_id, COALESCE(lower(NULLIF(t.tx_hash, '')), 'row:' || t.id::text), t.asset, upper(t.side)) AS has_net FROM trades t WHERE t.whale_id IN (SELECT id FROM whales WHERE lower(username) = 'rn1') AND t.ts >= now() - interval '48 hours'