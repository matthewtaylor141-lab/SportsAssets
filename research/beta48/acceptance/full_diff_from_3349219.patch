                 maker-rests) SQL="WITH e AS (SELECT o.id, o.book_id, round(o.wire::numeric, 4) AS wire, o.qty, o.filled, o.state, o.taker_at_placement, o.placed_at, o.done_at, o.his_level, o.bid_at_place, o.ask_at_place, o.side, CASE WHEN b.intent = 'ORDER_INTENT_BUY_SHORT' THEN 'short' ELSE 'long' END AS side_w, CASE WHEN o.kind = 'increase' THEN 'add' ELSE 'reduce' END AS leg, CASE WHEN o.his_level IS NULL THEN 'unpriced' WHEN o.side = 'BUY_LONG' AND round(o.wire::numeric, 4) = floor(round((o.his_level * 100)::numeric, 6)) / 100 THEN 'his_cent' WHEN o.side = 'SELL_LONG' AND round(o.wire::numeric, 4) = ceil(round((o.his_level * 100)::numeric, 6)) / 100 THEN 'his_cent' ELSE 'touch' END AS clause, CASE WHEN m.resolved_prices IS NULL OR mt.outcome_index IS NULL THEN NULL ELSE (m.resolved_prices->>mt.outcome_index)::numeric END AS payoff FROM mirror_orders o JOIN mirror_books b ON b.id = o.book_id LEFT JOIN market_tokens mt ON mt.token_id = b.long_asset LEFT JOIN markets m ON m.condition_id = b.condition_id WHERE b.whale = 'rn1' AND o.post_only IS TRUE AND o.tif IN ('GTC', 'GTD') AND o.placed_at >= now() - interval '24 hours'), x AS (SELECT e.*, CASE WHEN side_w = 'short' AND side = 'SELL_LONG' THEN 1 - wire ELSE wire END AS cost_px, CASE WHEN his_level IS NULL THEN NULL WHEN side = 'BUY_LONG' THEN round(((wire - floor(round((his_level * 100)::numeric, 6)) / 100) * 100)::numeric, 1) ELSE round(((ceil(round((his_level * 100)::numeric, 6)) / 100 - wire) * 100)::numeric, 1) END AS from_his_c, CASE WHEN side = 'BUY_LONG' AND ask_at_place IS NOT NULL THEN round(((ask_at_place::numeric - wire) * 100)::numeric, 1) WHEN side = 'SELL_LONG' AND bid_at_place IS NOT NULL THEN round(((wire - bid_at_place::numeric) * 100)::numeric, 1) ELSE NULL END AS from_touch_c, extract(epoch FROM (done_at - placed_at)) AS ttf_s FROM e) SELECT COALESCE(side_w, 'ALL') AS side, COALESCE(leg, 'ALL') AS leg, COALESCE(clause, 'ALL') AS clause, count(*) AS rests, count(*) FILTER (WHERE state = 'open') AS standing, count(*) FILTER (WHERE filled > 0) AS filled_n, count(*) FILTER (WHERE filled >= qty) AS filled_whole, round(100.0 * count(*) FILTER (WHERE filled > 0) / NULLIF(count(*), 0), 1) AS fill_pct, round(sum(filled * cost_px)::numeric, 2) AS filled_usd, round(100.0 * count(*) FILTER (WHERE filled > 0 AND taker_at_placement IS NOT TRUE) / NULLIF(count(*) FILTER (WHERE filled > 0), 0), 1) AS maker_fill_pct, count(*) FILTER (WHERE taker_at_placement IS TRUE) AS crossed_at_create, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY from_his_c)::numeric, 1) AS from_his_c_med, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY from_touch_c)::numeric, 1) AS from_touch_c_med, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY ttf_s) FILTER (WHERE filled > 0)::numeric, 0) AS ttf_med_s, round(sum(greatest(qty - filled, 0) * cost_px)::numeric, 2) AS unfilled_usd, count(*) FILTER (WHERE leg = 'add' AND filled > 0 AND payoff IS NOT NULL) AS n_resolved, round((sum(CASE WHEN side = 'BUY_LONG' THEN filled * (payoff - wire) ELSE filled * (wire - payoff) END) FILTER (WHERE leg = 'add' AND filled > 0 AND payoff IS NOT NULL) / NULLIF(sum(filled * cost_px) FILTER (WHERE leg = 'add' AND filled > 0 AND payoff IS NOT NULL), 0))::numeric, 4) AS roi, round((1.96 * stddev_samp(CASE WHEN side = 'BUY_LONG' THEN (payoff - wire) / NULLIF(wire, 0) ELSE (wire - payoff) / NULLIF(cost_px, 0) END) FILTER (WHERE leg = 'add' AND filled > 0 AND payoff IS NOT NULL) / sqrt(NULLIF(count(*) FILTER (WHERE leg = 'add' AND filled > 0 AND payoff IS NOT NULL), 0)))::numeric, 4) AS ci95 FROM x GROUP BY ROLLUP (side_w, leg, clause) ORDER BY 1, 2, 3; WITH e AS (SELECT o.id, o.book_id, o.state, o.reason, o.qty, o.filled, o.placed_at, o.done_at, CASE WHEN b.intent = 'ORDER_INTENT_BUY_SHORT' THEN 'short' ELSE 'long' END AS side_w, o.decision IN ('replace_cent', 'replace_qty', 'replace_side', 'ttl', 'replace_unread') AS replaced, CASE WHEN o.his_level IS NULL THEN NULL ELSE floor(round((o.his_level * 100)::numeric, 6