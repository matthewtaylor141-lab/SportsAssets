                 league-rows) SQL="WITH his AS (SELECT t.condition_id, t.market_slug, t.market_title, t.outcome, t.size * t.price AS usd, t.ts, regexp_replace(t.market_slug, '^([a-z0-9]+-[a-z0-9]+-[a-z0-9]+-[0-9]{4}-[0-9]{2}-[0-9]{2}).*$', '\\1') AS ev, (split_part(t.market_slug, '-', 8) = '' AND split_part(t.market_slug, '-', 7) IN (split_part(t.market_slug, '-', 2), split_part(t.market_slug, '-', 3))) AS is_ml FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '30 hours' AND split_part(COALESCE(t.market_slug, ''), '-', 1) IN ('por', 'itsb', 'col1', 'nor', 'gre1', 'bel1', 'ere', 'den', 'tur2', 'bra3', 'sui', 'cs2')), sh AS (SELECT DISTINCT ON (condition_id) condition_id, at, left(detail->>'explain', 44) AS explain FROM mirror_shadow WHERE whale = 'rn1' AND at >= now() - interval '36 hours' ORDER BY condition_id, at DESC) SELECT h.ev, count(DISTINCT h.market_slug) AS mkts, round(sum(h.usd)::numeric, 0) AS usd, max(h.ts)::time(0) AS last_ts, string_agg(DISTINCT regexp_replace(h.market_slug, '^' || h.ev || '-', ''), ',') AS tails, max(h.market_title) FILTER (WHERE h.is_ml) AS ml_title, max(left(m.event_title, 44)) AS m_event_title, max(left(m.title, 30)) FILTER (WHERE h.is_ml) AS m_title, string_agg(DISTINCT COALESCE(sh.explain, '(never judged)'), ' | ') AS verdicts, max(sh.at)::time(0) AS judged FROM his h LEFT JOIN markets m ON m.condition_id = h.condition_id LEFT JOIN sh ON sh.condition_id = h.condition_id GROUP BY h.ev ORDER BY sum(h.usd) DESC LIMIT 60; WITH he AS (SELECT DISTINCT split_part(t.market_slug, '-', 1) AS his_lg, substring(t.market_slug from position('-' in t.market_slug) + 1) AS rest FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '30 hours' AND split_part(COALESCE(t.market_slug, ''), '-', 1) IN ('por', 'itsb', 'col1', 'nor', 'gre1', 'bel1', 'ere', 'den', 'tur2', 'bra3', 'sui', 'cs2')) SELECT he.his_lg, u.identifier, u.side_norm, u.intent, u.line, left(u.question, 100) AS question, u.updated_at::time(0) AS upd FROM he JOIN us_premap u ON u.identifier LIKE ('%-' || he.rest) ORDER BY he.his_lg, u.identifier, u.side_norm LIMIT 70; WITH he AS (SELECT DISTINCT split_part(t.market_slug, '-', 1) AS his_lg, split_part(t.market_slug, '-', 2) || '-' || split_part(t.market_slug, '-', 3) || '-' || substring(t.market_slug from '[0-9]{4}-[0-9]{2}-[0-9]{2}') AS suffix FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '30 hours' AND split_part(COALESCE(t.market_slug, ''), '-', 1) IN ('por', 'itsb', 'col1', 'nor', 'gre1', 'bel1', 'ere', 'den', 'tur2', 'bra3', 'sui', 'cs2') AND t.market_slug ~ '^[a-z0-9]+-[a-z0-9]+-[a-z0-9]+-[0-9]{4}-[0-9]{2}-[0-9]{2}-') SELECT he.his_lg, u.identifier, u.side_norm, u.intent, left(u.question, 100) AS question, left(u.event_title, 40) AS v_event_title FROM he JOIN us_premap u ON u.identifier LIKE ('atc-%-' || he.suffix || '-%') WHERE u.identifier NOT LIKE '%-fh-%' AND u.identifier NOT LIKE '%-sh-%' ORDER BY he.his_lg, u.identifier, u.side_norm LIMIT 60; WITH nm AS (SELECT DISTINCT split_part(t.market_slug, '-', 1) AS his_lg, substring(t.market_slug from '[0-9]{4}-[0-9]{2}-[0-9]{2}') AS d, lower(trim(v.n)) AS his_name FROM trades t JOIN whales w ON w.id = t.whale_id LEFT JOIN markets m ON m.condition_id = t.condition_id CROSS JOIN LATERAL (VALUES (split_part(m.event_title, ' vs. ', 1)), (split_part(m.event_title, ' vs. ', 2)), (substring(t.market_title from '^Will (.+) win on '))) v(n) WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '30 hours' AND split_part(COALESCE(t.market_slug, ''), '-', 1) IN ('por', 'itsb', 'col1', 'nor', 'gre1', 'bel1', 'ere', 'den', 'tur2', 'bra3', 'sui', 'cs2') AND length(trim(COALESCE(v.n, ''))) >= 3) SELECT nm.his_lg, nm.d, nm.his_name, u.identifier, u.side_norm, left(u.question, 100) AS question FROM nm JOIN us_premap u ON u.identifier LIKE 'atc-%' AND u.identifier LIKE ('%-' || nm.d || '-%') AND translate(lower(u.question), 'áéíóúàèìòùâêîôûãõçñäöüøłđ', 'aeiouaeiouaeiouaocnaouold') LIKE ('%' || translate(nm.his_name, 'áéíóúàèìòùâêîôûãõçñäöüøłđ', 'aeiouaeiouaeiouaocnaouold') || '%') ORDER BY nm.his_lg, nm.d, nm.his_name, u.identifier, u.side_norm LIMIT 90;"; TO=60000 ;;
