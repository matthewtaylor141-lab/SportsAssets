                 sleeve-48h) SQL="WITH k AS (SELECT b.*, COALESCE(NULLIF(m.sport, 'unclassified'), '(unmapped)') AS sport, (CASE WHEN b.state = 'closed' AND b.settled_pnl IS NOT NULL THEN b.settled_pnl ELSE b.realized_pnl END) AS pnl FROM mirror_books b LEFT JOIN markets m ON m.condition_id = b.condition_id WHERE (b.opened_at >= now() - interval '48 hours' OR b.closed_at >= now() - interval '48 hours') AND lower(COALESCE(b.us_market_slug, '')) NOT LIKE 'aec-nfl-ne-sea-2026-09-09%') SELECT COALESCE(sport, 'ALL SPORTS') AS sport, count(*) AS books, count(*) FILTER (WHERE state = 'closed') AS closed, count(*) FILTER (WHERE state <> 'closed') AS still_open, round(sum(peak_exposure_usd)::numeric, 2) AS staked, round(sum(pnl)::numeric, 2) AS pnl, round((100 * sum(pnl) / NULLIF(sum(peak_exposure_usd), 0))::numeric, 2) AS roi_pct, count(*) FILTER (WHERE pnl > 0) AS won, count(*) FILTER (WHERE pnl < 0) AS lost, count(*) FILTER (WHERE pnl = 0 OR pnl IS NULL) AS flat, count(*) FILTER (WHERE intent = 'ORDER_INTENT_BUY_SHORT') AS shorts FROM k GROUP BY ROLLUP (sport) ORDER BY sum(pnl) ASC NULLS FIRST; WITH k AS (SELECT b.*, COALESCE(NULLIF(m.sport, 'unclassified'), '(unmapped)') AS sport, (CASE WHEN b.state = 'closed' AND b.settled_pnl IS NOT NULL THEN b.settled_pnl ELSE b.realized_pnl END) AS pnl FROM mirror_books b LEFT JOIN markets m ON m.condition_id = b.condition_id WHERE (b.opened_at >= now() - interval '48 hours' OR b.closed_at >= now() - interval '48 hours') AND lower(COALESCE(b.us_market_slug, '')) NOT LIKE 'aec-nfl-ne-sea-2026-09-09%') SELECT sport, id, left(COALESCE(us_market_slug, '(none)'), 40) AS slug, CASE WHEN intent = 'ORDER_INTENT_BUY_SHORT' THEN 'SHORT' ELSE 'LONG' END AS side, state, round(ledger_net::numeric, 1) AS held, round(avg_cost::numeric, 4) AS avg_cost, round(peak_exposure_usd::numeric, 2) AS staked, round(realized_pnl::numeric, 2) AS realized, round(settled_pnl::numeric, 2) AS settled, round(pnl::numeric, 2) AS pnl, opened_at::timestamp(0) AS opened