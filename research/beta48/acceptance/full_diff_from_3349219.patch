                 two-legged) SQL="WITH f AS (SELECT 0.000::float8 AS fee), s AS (SELECT DISTINCT ON (condition_id) condition_id, at, detail, COALESCE(detail->>'his_sport', detail->>'sport', 'unclassified') AS sport FROM mirror_shadow WHERE whale = 'rn1' AND at >= now() - interval '24 hours' AND COALESCE((detail->>'two_leg_both_sides')::boolean, false) ORDER BY condition_id, at DESC), m AS (SELECT s.sport, s.condition_id, f.fee, COALESCE((s.detail->>'two_leg_mapped')::boolean, false) AS mapped, (s.detail->>'two_leg_his_cost_usd')::float8 AS his_usd, (s.detail->>'two_leg_pair_cost')::float8 AS our_pc, (s.detail->>'two_leg_rest_pair_cost')::float8 AS rest_pc, (s.detail->>'two_leg_his_pair_cost')::float8 AS his_pc, (s.detail->>'two_leg_pair_edge')::float8 AS edge, COALESCE((s.detail->>'two_leg_pair_target')::int, 0) AS tgt, (s.detail->>'two_leg_matched_sh')::float8 AS his_matched, (s.detail->>'two_leg_residual_sh')::float8 AS his_resid, s.detail->>'two_leg_refusal' AS refusal, s.detail->>'two_leg_quote_src' AS qsrc FROM s CROSS JOIN f) SELECT COALESCE(sport, 'ALL') AS sport, count(*) AS both_sides_mkts, count(*) FILTER (WHERE mapped) AS mapped_mkts, round(sum(his_usd)::numeric, 0) AS his_usd, round(COALESCE(sum(his_usd) FILTER (WHERE mapped), 0)::numeric, 0) AS his_usd_mapped, round((100 * COALESCE(sum(his_usd) FILTER (WHERE mapped), 0) / NULLIF(sum(his_usd), 0))::numeric, 1) AS coverage_pct, count(*) FILTER (WHERE our_pc IS NOT NULL) AS priced, round(avg(our_pc)::numeric, 4) AS take_pair_cost, count(*) FILTER (WHERE our_pc + 2 * fee < 1.0) AS take_admissible, round(avg(rest_pc)::numeric, 4) AS rest_pair_cost, count(*) FILTER (WHERE rest_pc + 2 * fee < 1.0) AS rest_admissible, round((100 * count(*) FILTER (WHERE rest_pc + 2 * fee < 1.0) / NULLIF(count(*) FILTER (WHERE rest_pc IS NOT NULL), 0)::float8)::numeric, 1) AS rest_admissible_pct, round(avg(his_pc)::numeric, 4) AS his_pair_cost, round(avg(rest_pc - his_pc)::numeric, 4) AS rest_edge_avg, round(avg(edge)::numeric, 4) AS take_edge_avg, round(avg((1.0 - rest_pc) / 2.0)::numeric, 4) AS breakeven_fee_pc, round((sum(his_matched * (1.0 - rest_pc - 2 * fee)) FILTER (WHERE rest_pc + 2 * fee < 1.0))::numeric, 0) AS his_matched_profit_at_rest, sum(tgt) AS our_pairs, round((sum(tgt * (1.0 - rest_pc - 2 * fee)) FILTER (WHERE rest_pc + 2 * fee < 1.0))::numeric, 2) AS our_profit_at_rest, round(sum(his_resid)::numeric, 0) AS his_residual_sh_declined FROM m GROUP BY ROLLUP (sport) ORDER BY sum(his_usd) DESC NULLS LAST LIMIT 30; WITH r AS (SELECT COALESCE(detail->>'his_sport', detail->>'sport', 'unclassified') AS sport, (detail->>'two_leg_both_obtainable')::boolean AS both_ok, COALESCE((detail->>'two_leg_fill_long')::boolean, false) AS leg_long, COALESCE((detail->>'two_leg_fill_other')::boolean, false) AS leg_other, (detail->>'two_leg_rest_pair_cost')::float8 AS rest_pc, (detail->>'two_leg_his_pair_cost')::float8 AS his_pc, (detail->>'two_leg_touched_s_long')::int AS t_long, (detail->>'two_leg_touched_s_other')::int AS t_other FROM mirror_shadow WHERE whale = 'rn1' AND at >= now() - interval '24 hours' AND detail ? 'two_leg_rest_long_px') SELECT COALESCE(sport, 'ALL') AS sport, count(*) AS rests, count(*) FILTER (WHERE both_ok IS NOT NULL) AS judged, count(*) FILTER (WHERE both_ok) AS both_obtainable, round((100 * count(*) FILTER (WHERE both_ok) / NULLIF(count(*) FILTER (WHERE both_ok IS NOT NULL), 0)::float8)::numeric, 1) AS both_pct, count(*) FILTER (WHERE leg_long AND NOT leg_other) AS long_leg_only, count(*) FILTER (WHERE leg_other AND NOT leg_long) AS other_leg_only, count(*) FILTER (WHERE NOT leg_long AND NOT leg_other) AS neither, round(avg(rest_pc)::numeric, 4) AS rest_pair_cost, round(avg(rest_pc) FILTER (WHERE both_ok)::numeric, 4) AS rest_pc_when_both, round(avg(his_pc) FILTER (WHERE both_ok)::numeric, 4) AS his_pc_when_both, round(avg(GREATEST(t_long, t_other)) FILTER (WHERE both_ok)::numeric, 0) AS both_wait_s FROM r GROUP BY ROLLUP (sport) ORDER BY count(*) DESC LIMIT 30; WITH f AS (SELECT 0.000::float8 AS fee), s AS (SELECT DISTINCT ON (condition_id) condition_id, at, detail, COALESCE(detail->>'his_sport', detail->>'sport', 'unclassified') AS sport FROM mirror_shadow WHERE whale = 'rn1' AND at >= now() - interval '24 hours' AND COALESCE((detail->>'two_leg_both_sides')::boolean, false) ORDER BY condition_id, at DESC), m AS (SELECT s.sport, s.condition_id, f.fee, COALESCE((s.detail->>'two_leg_mapped')::boolean, false) AS mapped, (s.detail->>'two_leg_his_cost_usd')::float8 AS his_usd, (s.detail->>'two_leg_pair_cost')::float8 AS our_pc, (s.detail->>'two_leg_rest_pair_cost')::float8 AS rest_pc, (s.detail->>'two_leg_his_pair_cost')::float8 AS his_pc, (s.detail->>'two_leg_pair_edge')::float8 AS edge, COALESCE((s.detail->>'two_leg_pair_target')::int, 0) AS tgt, (s.detail->>'two_leg_matched_sh')::float8 AS his_matched, (s.detail->>'two_leg_residual_sh')::float8 AS his_resid, s.detail->>'two_leg_refusal' AS refusal, s.detail->>'two_leg_quote_src' AS qsrc FROM s CROSS JOIN f) SELECT COALESCE(sport, 'ALL') AS sport, CASE WHEN rest_pc IS NULL OR his_pc IS NULL THEN '9 unpriced' WHEN rest_pc - his_pc < -0.02 THEN '1 ours 2c+ better' WHEN rest_pc - his_pc < 0.0 THEN '2 ours better' WHEN rest_pc - his_pc < 0.02 THEN '3 within 2c' WHEN rest_pc - his_pc < 0.05 THEN '4 ours 2-5c worse' ELSE '5 ours 5c+ worse' END AS rest_edge_band, count(*) AS mkts, round(sum(his_usd)::numeric, 0) AS his_usd, round((100 * sum(his_usd) / NULLIF(sum(sum(his_usd)) OVER (PARTITION BY sport), 0))::numeric, 1) AS his_usd_pct, round(avg(rest_pc)::numeric, 4) AS rest_pair_cost, round(avg(his_pc)::numeric, 4) AS his_pair_cost, round(avg(our_pc)::numeric, 4) AS take_pair_cost FROM m GROUP BY ROLLUP (sport), 2 ORDER BY sport NULLS FIRST, 2 LIMIT 80; WITH f AS (SELECT 0.000::float8 AS fee), s AS (SELECT DISTINCT ON (condition_id) condition_id, at, detail, COALESCE(detail->>'his_sport', detail->>'sport', 'unclassified') AS sport FROM mirror_shadow WHERE whale = 'rn1' AND at >= now() - interval '24 hours' AND COALESCE((detail->>'two_leg_both_sides')::boolean, false) ORDER BY condition_id, at DESC), m AS (SELECT s.sport, s.condition_id, f.fee, COALESCE((s.detail->>'two_leg_mapped')::boolean, false) AS mapped, (s.detail->>'two_leg_his_cost_usd')::float8 AS his_usd, (s.detail->>'two_leg_pair_cost')::float8 AS our_pc, (s.detail->>'two_leg_rest_pair_cost')::float8 AS rest_pc, (s.detail->>'two_leg_his_pair_cost')::float8 AS his_pc, (s.detail->>'two_leg_pair_edge')::float8 AS edge, COALESCE((s.detail->>'two_leg_pair_target')::int, 0) AS tgt, (s.detail->>'two_leg_matched_sh')::float8 AS his_matched, (s.detail->>'two_leg_residual_sh')::float8 AS his_resid, s.detail->>'two_leg_refusal' AS refusal, s.detail->>'two_leg_quote_src' AS qsrc FROM s CROSS JOIN f) SELECT COALESCE(refusal, CASE WHEN tgt > 0 THEN '(a pair)' ELSE '(none)' END) AS refusal, COALESCE(qsrc, '(unmapped)') AS quote_src, count(*) AS mkts, round(sum(his_usd)::numeric, 0) AS his_usd, round(avg(our_pc)::numeric, 4) AS take_pair_cost, round(avg(rest_pc)::numeric, 4) AS rest_pair_cost, round(avg(his_pc)::numeric, 4) AS his_pair_cost, sum(tgt) AS our_pairs FROM m GROUP BY 1, 2 ORDER BY sum(his_usd) DESC NULLS LAST LIMIT 30;"; TO=120000 ;;
-                # IS HIS BOOK ACTUALLY BINARY? (E38, 2026-09-10; read-only.) The his-matched arithmetic
-                # pairs outcome_index 0 against outcome_index 1 and filters `outcome_index IN (0, 1)`.
