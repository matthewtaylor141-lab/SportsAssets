                 cfb-venue) SQL="SELECT identifier, side_norm, intent, left(event_title, 40) AS v_event_title, left(question, 120) AS question FROM us_premap WHERE identifier LIKE 'aec-cfb-%' AND (identifier LIKE '%-2026-09-06' OR identifier LIKE '%-2026-09-07') ORDER BY identifier, side_norm LIMIT 120; WITH ev AS (SELECT DISTINCT split_part(t.market_slug, '-', 1) || '-' || split_part(t.market_slug, '-', 2) || '-' || split_part(t.market_slug, '-', 3) || '-' || substring(t.market_slug from '[0-9]{4}-[0-9]{2}-[0-9]{2}') AS ev FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '30 hours' AND t.market_slug LIKE 'cfb-%') SELECT ev.ev, split_part(u.identifier, '-', 1) AS prefix, count(*) AS rows, left(string_agg(DISTINCT CASE WHEN split_part(u.identifier, '-', 1) IN ('tsc', 'asc') AND u.identifier !~ '-(1h|2h|1q|2q|3q|4q|fh|sh)-' THEN substr(u.identifier, position(ev.ev in u.identifier) + length(ev.ev) + 1) END, ' '), 400) AS full_game_tails FROM ev JOIN us_premap u ON u.identifier LIKE '%-' || ev.ev || '%' GROUP BY 1, 2 ORDER BY 1, 2 LIMIT 80; WITH ev AS (SELECT DISTINCT split_part(t.market_slug, '-', 1) || '-' || split_part(t.market_slug, '-', 2) || '-' || split_part(t.market_slug, '-', 3) || '-' || substring(t.market_slug from '[0-9]{4}-[0-9]{2}-[0-9]{2}') AS ev FROM trades t JOIN whales w ON w.id = t.whale_id WHERE lower(w.username) = 'rn1' AND t.ts >= now() - interval '30 hours' AND t.market_slug LIKE 'cfb-%') SELECT ev.ev, string_agg(DISTINCT CASE WHEN u.identifier LIKE 'aec-%' THEN u.side_norm END, '/') AS aec_sides, max(CASE WHEN u.identifier LIKE 'aec-%' THEN left(u.event_title, 40) END) AS v_event_title, min(CASE WHEN u.identifier LIKE 'asc-%' AND u.identifier !~ '-(1h|2h|1q|2q|3q|4q)-' THEN left(u.question, 95) END) AS asc_question, min(CASE WHEN u.identifier LIKE 'asc-%-1h-%' THEN left(u.question, 95) END) AS asc_1h_question, left(string_agg(DISTINCT CASE WHEN u.identifier LIKE 'atc-%-winner-1h-%' THEN