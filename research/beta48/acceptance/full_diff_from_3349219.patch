                 fill-answers) SQL="WITH w AS (SELECT condition_id, name, count(*) AS n, count(order_id) AS with_order, min(fill_ts) AS oldest, max(fill_ts) AS newest FROM mirror_fill_answers WHERE whale = 'rn1' AND at >= extract(epoch FROM now() - interval '24 hours') GROUP BY 1, 2), a AS (SELECT condition_id, sum(n) AS written, sum(with_order) AS with_order, min(oldest) AS oldest_written, max(newest) AS newest_written, string_agg(name || '=' || n, ' ' ORDER BY n DESC, name) AS names FROM w GROUP BY 1), h AS (SELECT d.condition_id, count(*) AS held, min(d.ts) AS oldest_fill FROM (SELECT t.id, t.condition_id, t.ts, COALESCE(t.source, '') IN ('chain', 's1') AS net_leg, bool_or(COALESCE(t.source, '') IN ('chain', 's1')) OVER (PARTITION BY t.whale_id, COALESCE(lower(NULLIF(t.tx_hash, '')), 'row:' || t.id::text), t.asset, upper(t.side)) AS has_net FROM trades t JOIN whales wh ON wh.id = t.whale_id WHERE lower(wh.username) = 'rn1' AND t.ts >= now() - interval '24 hours' AND t.condition_id IN (SELECT condition_id FROM mirror_books WHERE whale = 'rn1')) d WHERE (d.net_leg OR NOT d.has_net) GROUP BY 1), b AS (SELECT DISTINCT ON (condition_id) condition_id, id AS book, left(us_market_slug, 36) AS slug, state, (SELECT min((e->>'ts')::float8) FROM jsonb_array_elements(CASE WHEN jsonb_typeof(last_plan->'his_fills_seen') = 'array' THEN last_plan->'his_fills_seen' ELSE '[]'::jsonb END) e WHERE NOT ((e->>'ts') ~ '[^0-9.]')) AS plan_oldest_kept, CASE WHEN NOT ((last_plan->>'fills_hwm') ~ '[^0-9.]') THEN (last_plan->>'fills_hwm')::float8 END AS fills_hwm FROM mirror_books WHERE whale = 'rn1' ORDER BY condition_id, id DESC), c AS (SELECT x.condition_id, string_agg(x.cause || '=' || x.n, ' ' ORDER BY x.n DESC, x.cause) AS causes FROM xmltable('/table/row' PASSING (CASE WHEN NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name = 'mirror_fill_answers' AND column_name = 'cause') THEN '<table/>'::xml ELSE query_to_xml('SELECT condition_id, cause, count(*) AS n FROM mirror_fill_answers WHERE whale = ''rn1'' AND cause IS NOT NULL AND at >= extract(epoch FROM now() - interval ''24 hours'') GROUP BY 1, 2', false, false, '') END) COLUMNS condition_id text PATH 'condition_id', cause text PATH 'cause', n bigint PATH 'n') x GROUP BY 1) SELECT b.book, b.slug, b.state, COALESCE(h.held, 0) AS held_24h, COALESCE(a.written, 0) AS written, COALESCE(a.with_order, 0) AS with_order, left(a.names, 120) AS names, left(c.causes, 60) AS causes, to_timestamp(a.oldest_written)::time(0) AS oldest_written, to_timestamp(b.plan_oldest_kept)::time(0) AS plan_oldest_kept, to_timestamp(b.fills_hwm)::time(0) AS fills_hwm FROM b LEFT JOIN h ON h.condition_id = b.condition_id LEFT JOIN a ON a.condition_id = b.condition_id LEFT JOIN c ON c.condition_id = b.condition_id WHERE COALESCE(h.held, 0) > 0 OR COALESCE(a.written, 0) > 0 ORDER BY 4 DESC, 1 DESC LIMIT 60; SELECT count(*) AS rows_24h, count(DISTINCT condition_id) AS markets, count(order_id) AS with_order, count(DISTINCT name) AS names, to_timestamp(min(at))::time(0) AS first_at, to_timestamp(max(at))::time(0) AS last_at FROM mirror_fill_answers WHERE whale = 'rn1' AND at >= extract(epoch FROM now() - interval '24 hours');"; TO=60000 ;;
