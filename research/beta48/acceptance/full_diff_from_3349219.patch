                 his-board) SQL="WITH his AS (SELECT t.condition_id, t.side, t.size, t.price, t.ts, t.market_slug, (m.resolved_prices->>mt.outcome_index)::numeric AS rp, (m.resolved_prices IS NOT NULL) AS settled FROM (SELECT t.*, bool_or(t.source IN ('chain', 's1')) OVER (PARTITION BY t.whale_id, COALESCE(lower(NULLIF(t.tx_hash, '')), 'row:' || t.id::text), t.asset, upper(t.side)) AS has_net FROM trades t WHERE t.whale_id IN (SELECT id FROM whales WHERE lower(username) = 'rn1') AND t.ts >= now() - interval '48 hours') t JOIN whales w ON w.id = t.whale_id JOIN market_tokens mt ON mt.token_id = t.asset LEFT JOIN markets m ON m.condition_id = t.condition_id WHERE lower(w.username) = 'rn1' AND (t.source IN ('chain', 's1') OR NOT t.has_net) AND t.ts >= now() - interval '24 hours'), hl AS (SELECT condition_id, max(ts) AS last_ts FROM his GROUP BY 1), bk AS (SELECT DISTINCT condition_id FROM mirror_books WHERE whale = 'rn1'), cr AS (SELECT DISTINCT ON (r.condition_id) r.condition_id, r.refusal FROM mirror_candidate_refusals r LEFT JOIN hl ON hl.condition_id = r.condition_id WHERE r.whale = 'rn1' AND r.at >= now() - interval '30 hours' ORDER BY r.condition_id, (r.at <= hl.last_ts) DESC NULLS LAST, r.at DESC), sh AS (SELECT DISTINCT ON (s.condition_id) s.condition_id, s.reason, left(s.detail->>'explain', 40) AS explain FROM mirror_shadow s LEFT JOIN hl ON hl.condition_id = s.condition_id WHERE s.whale = 'rn1' AND s.at >= now() - interval '30 hours' ORDER BY s.condition_id, (s.at <= hl.last_ts) DESC NULLS LAST, s.at DESC), x AS (SELECT h.condition_id, h.size, h.price, h.settled, split_part(COALESCE(h.market_slug, ''), '-', 1) AS league, CASE WHEN bk.condition_id IS NOT NULL THEN 'MIRRORED' WHEN cr.refusal = 'unmapped' THEN 'unmapped (no US contract bound)' WHEN cr.refusal IS NOT NULL THEN 'US board, refused: ' || cr.refusal ELSE 'never judged live: ' || COALESCE(sh.explain, sh.reason, '?') END AS bucket, (CASE WHEN upper(h.side) = 'BUY' THEN 1 ELSE -1 END) * h.size * (h.rp - h.price) AS pnl FROM his h LEFT JOIN bk ON bk.condition_id = h.condition_id LEFT JOIN cr ON cr.condition_id = h.condition_id LEFT JOIN sh ON sh.condition_id = h.condition_id) SELECT COALESCE(bucket, 'ALL') AS bucket, count(DISTINCT condition_id) AS markets, count(*) AS fills, round(sum(size * price)::numeric, 0) AS usd, count(DISTINCT CASE WHEN settled THEN condition_id END) AS settled_mkts, round(sum(CASE WHEN settled THEN size * price ELSE 0 END)::numeric, 0) AS usd_settled, round(sum(CASE WHEN settled THEN pnl ELSE 0 END)::numeric, 0) AS his_settled_pnl FROM x GROUP BY ROLLUP (bucket) ORDER BY bucket IS NULL, 4 DESC LIMIT 40; WITH his AS (SELECT t.condition_id, t.side, t.size, t.price, t.ts, t.market_slug, (m.resolved_prices->>mt.outcome_index)::numeric AS rp, (m.resolved_prices IS NOT NULL) AS settled FROM (SELECT t.*, bool_or(t.source IN ('chain', 's1')) OVER (PARTITION BY t.whale_id, COALESCE(lower(NULLIF(t.tx_hash, '')), 'row:' || t.id::text), t.asset, upper(t.side)) AS has_net FROM trades t WHERE t.whale_id IN (SELECT id FROM whales WHERE lower(username) = 'rn1') AND t.ts >= now() - interval '48 hours') t JOIN whales w ON w.id = t.whale_id JOIN market_tokens mt ON mt.token_id = t.asset LEFT JOIN markets m ON m.condition_id = t.condition_id WHERE lower(w.username) = 'rn1' AND (t.source IN ('chain', 's1') OR NOT t.has_net) AND t.ts >= now() - interval '24 hours'), hl AS (SELECT condition_id, max(ts) AS last_ts FROM his GROUP BY 1), bk AS (SELECT DISTINCT condition_id FROM mirror_books WHERE whale = 'rn1'), cr AS (SELECT DISTINCT ON (r.condition_id) r.condition_id, r.refusal FROM mirror_candidate_refusals r LEFT JOIN hl ON hl.condition_id = r.condition_id WHERE r.whale = 'rn1' AND r.at >= now() - interval '30 hours' ORDER BY r.condition_id, (r.at <= hl.last_ts) DESC NULLS LAST, r.at DESC), sh AS (SELECT DISTINCT ON (s.condition_id) s.condition_id, s.reason, left(s.detail->>'explain', 40) AS explain FROM mirror_shadow s LEFT JOIN hl ON hl.condition_id = s.condition_id WHERE s.whale = 'rn1' AND s.at >= now() - interval '30 hours' ORDER BY s.condition_id, (s.at <= hl.last_ts) DESC NULLS LAST, s.at DESC), x AS (SELECT h.condition_id, h.size, h.price, h.settled, split_part(COALESCE(h.market_slug, ''), '-', 1) AS league, CASE WHEN bk.condition_id IS NOT NULL THEN 'MIRRORED' WHEN cr.refusal = 'unmapped' THEN 'unmapped (no US contract bound)' WHEN cr.refusal IS NOT NULL THEN 'US board, refused: ' || cr.refusal ELSE 'never judged live: ' || COALESCE(sh.explain, sh.reason, '?') END AS bucket, (CASE WHEN upper(h.side) = 'BUY' THEN 1 ELSE -1 END) * h.size * (h.rp - h.price) AS pnl FROM his h LEFT JOIN bk ON bk.condition_id = h.condition_id LEFT JOIN cr ON cr.condition_id = h.condition_id LEFT JOIN sh ON sh.condition_id = h.condition_id) SELECT league, COALESCE(bucket, 'ALL') AS bucket, count(DISTINCT condition_id) AS markets, count(*) AS fills, round(sum(size * price)::numeric, 0) AS usd, count(DISTINCT CASE WHEN settled THEN condition_id END) AS settled_mkts, round(sum(CASE WHEN settled THEN size * price ELSE 0 END)::numeric, 0) AS usd_settled, round(sum(CASE WHEN settled THEN pnl ELSE 0 END)::numeric, 0) AS his_settled_pnl FROM x WHERE bucket LIKE 'unmapped%' OR bucket = 'MIRRORED' GROUP BY league, ROLLUP (bucket) ORDER BY league, bucket IS NULL, 4 DESC LIMIT 80;"; TO=60000 ;;
