{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/ops/repo-snapshot-guard.sh\"",
            "timeout": 45,
            "statusMessage": "verifying the checkout is not a reverted snapshot"
          }
        ]
      }
    ]
  }
}
