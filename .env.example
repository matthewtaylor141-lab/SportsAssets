# ── Core infrastructure ─────────────────────────────────────────────
DATABASE_URL=postgresql://sportsassets:sportsassets@localhost:5432/sportsassets
REDIS_URL=redis://localhost:6379/0

# ── Polygon RPC (Path A on-chain detection) ─────────────────────────
# Alchemy or QuickNode Polygon mainnet endpoints.
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_HTTP_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# Polymarket exchange contracts (config-driven; verify against docs before deploy).
CTF_EXCHANGE_ADDRESS=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E
NEG_RISK_CTF_EXCHANGE_ADDRESS=0xC5d563A36AE78145C45a50134d48A1215220f80a

# ── Public Polymarket APIs ──────────────────────────────────────────
DATA_API_BASE=https://data-api.polymarket.com
GAMMA_API_BASE=https://gamma-api.polymarket.com
LEADERBOARD_API_BASE=https://lb-api.polymarket.com

# ── Roster ──────────────────────────────────────────────────────────
ROSTER_SIZE=5
ROSTER_MIN_RESOLVED_POSITIONS=200
ROSTER_MAX_INACTIVE_DAYS=14
ROSTER_REFRESH_INTERVAL_HOURS=168

# ── Ingestion ───────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=5.0
DATA_API_MAX_RPS=4.0
POSITIONS_SYNC_INTERVAL_SECONDS=300
HISTORY_MAX_TRADES=500000
HISTORY_START_DATE=2025-07-01
POLL_FAILURE_ALERT_THRESHOLD=3
WS_DOWN_ALERT_SECONDS=30
RECONCILE_INTERVAL_SECONDS=3600
METADATA_REFRESH_SECONDS=60

# ── Notifications ───────────────────────────────────────────────────
# Generate VAPID keys with: python -m sportsassets.scripts.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_INVITE_URL=
BURST_COLLAPSE_THRESHOLD=5
BURST_COLLAPSE_WINDOW_SECONDS=60

# ── API ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_TOKEN=change-me
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite; set at build time) ──────────────────────────────
VITE_API_BASE=http://localhost:8000

# ── Edge engine (shadow mode; see edge-engine/CLAUDE.md) ────────────
# Licensed odds feed key (The Odds API tier). Required for the shadow runner.
EDGE_ODDS_API_KEY=
EDGE_CYCLE_SECONDS=120
# EDGE_SPORT_KEYS=soccer_epl,basketball_nba   # default: all mapped sports
